# Supabase — get from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_SUPABASE_WATCHLIST_TABLE=watchlist

# NOTE: ANTHROPIC_API_KEY goes in Vercel dashboard only (never expose in client .env)
# NOTE: TVMaze API is free and public — no key needed, called directly from browser
